# Copy the values you need into .env.local (never commit real keys).
# On Vercel, add the same names under Project > Settings > Environment Variables.

# Public (safe in the browser)
VITE_SITE_URL=https://maverickdigitalhub.com
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Optional spam check (Cloudflare Turnstile). Leave empty to switch it 
VITE_TURNSTILE_SITE_KEY=

# Server only (no VITE_ prefix, so they never reach the browser)
SUPABASE_SECRET_KEY=sb_secret_...
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...
# Optional: defaults to the account's main calendar
GOOGLE_CALENDAR_ID=primary
# Where new-booking emails go (defaults to the business email)
NOTIFY_EMAIL=mavericktech750@gmail.com
TURNSTILE_SECRET_KEY=
# Any long random string; Vercel sends it with the daily keepalive
CRON_SECRET=
